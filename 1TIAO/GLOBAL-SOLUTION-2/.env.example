# Copie para ".env" (que não vai para o Git) e preencha.

# Segredo compartilhado entre o ESP32 (secrets.h) e a ponte MQTT
REFUGIO_HMAC_SEGREDO=demo-troque-este-segredo

# Broker MQTT (padrão: broker público HiveMQ com TLS; em produção, endpoint do AWS IoT Core)
REFUGIO_MQTT_HOST=broker.hivemq.com
REFUGIO_MQTT_PORTA=8883

# AWS (opcional). Credenciais via "aws configure" ou variáveis padrão do SDK - nunca no código.
AWS_REGION=us-east-1
# REFUGIO_DYNAMO_TABELA=refugio-leituras
